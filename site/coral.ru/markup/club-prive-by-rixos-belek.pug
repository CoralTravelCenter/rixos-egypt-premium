include ../markup/mixins

- const hotel = hotels.find(hotel => hotel.id === 21888);

body
    script
        != `var known_hotel = ${ JSON.stringify(hotel) };`

    +internal-nav([
        { label: 'Номера', ref: 'section.suites' },
        { label: 'Рестораны и бары', ref: 'section.restaurants-and-bars' },
        { label: 'RixyKidsClub', ref: 'section.rixy-club' },
        { label: 'CoralBonus', ref: 'section.coral-bonus' },
        { label: 'Контакты', ref: 'section.leased-line-premium' },
    ], '/chain/rixos/turkey/', '.interactive-map', { label: 'Выбрать номер', ref: 'section.suites' })

    +kvv({
        h1: 'Club Prive By Rixos Belek',
        logo: '/site/coral.ru/assets/logos/club-prive-by-rixos-belek.png',
        desktop_poster: '/site/coral.ru/assets/club-prive-by-rixos-belek/kv.webp',
        mobile_poster:  '/site/coral.ru/assets/club-prive-by-rixos-belek/kv_m.webp',
        desktop_vid: 1103730839,
        mobile_vid: 1103730887,
        video_scale: 1.5,
        five_stars: true,
        location: 'Турция, Белек'
    })

    section.held.intro
        .inhalt
            h2 Добро пожаловать в Club Prive By Rixos Belek
            p.generic
                :typo
                    Club Privé by Rixos предлагает гостям персональное обслуживание на частной вилле. Для проживания доступны несколько видов вилл, каждый из которых имеет собственные дополнительные услуги, входящие в стоимость. Всех гостей ожидает личная встреча в аэропорту и трансфер прямо до дверей виллы. Также гостям будут доступны специальные рестораны и бары, лучшие места на развлекательных площадках и услуги всей инфраструктуры отеля.

            .actions
                button.knopf(data-ref='section.suites') Выбрать номер

    section.held.suites
        .inhalt
            h2.rooms-splitter
            .rooms-list-combo
                .rooms-grid
                .rooms-paging.discrete-pager

    +gallery([
        { visual_desktop: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/01-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/01-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/02-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/02-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/03-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/03-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/04-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/04-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/05-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/05-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/06-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/06-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/07-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/07-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/08-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/08-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/09-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/club-prive-by-rixos-belek/gallery/09-gallery-mobile.webp' },
    ])

    +restaurants-and-bars({
        about: 'Составьте свой мини-гастрономический тур, включающий 11 ресторанов и 10 баров. Разнообразие мест и кухонь даст вам возможность пробовать что-то новое каждый день в уникальной атмосфере.',
        restaurants: [
            {
                visual: '/site/coral.ru/assets/club-prive-by-rixos-belek/restaurants-and-bars/rest-01.webp',
                heading: 'Club House',
                body: 'На завтраки подают органические блюда местной кухни. На обед и на ужин – блюда по меню: закуски, гриль, салаты из свежих овощейю.'
            },
            {
                visual: '/site/coral.ru/assets/club-prive-by-rixos-belek/restaurants-and-bars/rest-02.webp',
                heading: 'The Beach Lounge',
                body: 'Современный лаундж со стильным дизайном, где можно попробовать морепродукты. А также пасту, пиццу и полезные салаты.'
            },
            {
                visual: '/site/coral.ru/assets/club-prive-by-rixos-belek/restaurants-and-bars/rest-03.webp',
                heading: 'Mosaic',
                body: 'Ресторан, объединяющий международные кулинарные культуры, а также самые аутентичные вкусы.'
            },
            {
                visual: '/site/coral.ru/assets/club-prive-by-rixos-belek/restaurants-and-bars/rest-04.webp',
                heading: 'La Rosetta ',
                body: 'Вкусы Италии и Средиземноморья: великолепная пицца и восхитительная паста с чабрецом'
            },
            {
                visual: '/site/coral.ru/assets/club-prive-by-rixos-belek/restaurants-and-bars/rest-05.webp',
                heading: '24 Hours In-Villa Dining',
                body: 'Гости вилл могут насладиться креативными коктейлями, изысканными блюдами и круглосуточным сервисом.'
            },
            {
                visual: '/site/coral.ru/assets/club-prive-by-rixos-belek/restaurants-and-bars/rest-06.webp',
                heading: 'The Grill ',
                body: 'Вкуснейшие блюда на гриле, которые приготовят прямо при вас.'
            },

        ],
        bars: [
            {
                visual: '/site/coral.ru/assets/club-prive-by-rixos-belek/restaurants-and-bars/bar-01.webp',
                heading: 'Beach Bar',
                body: 'Место, где можно наслаждаться восхитительным видом, коктейлями и сетами диджеев.'
            },
            {
                visual: '/site/coral.ru/assets/club-prive-by-rixos-belek/restaurants-and-bars/bar-02.webp',
                heading: 'Club House',
                body: 'Круглосуточно доступно коктейли, широкий выбор вин и изысканные алкогольные напитки.'
            },

        ]
    })

    section.held.edge2edge.rixy-club.visuals-x-slider
        .x-slider
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/club-prive-by-rixos-belek/rixy-club/01-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/club-prive-by-rixos-belek/rixy-club/01-mobile.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/club-prive-by-rixos-belek/rixy-club/02-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/club-prive-by-rixos-belek/rixy-club/02-mobile.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/club-prive-by-rixos-belek/rixy-club/03-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/club-prive-by-rixos-belek/rixy-club/03-mobile.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/club-prive-by-rixos-belek/rixy-club/04-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/club-prive-by-rixos-belek/rixy-club/04-mobile.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/club-prive-by-rixos-belek/rixy-club/05-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/club-prive-by-rixos-belek/rixy-club/05-mobile.webp)')
        .overlay
            h2 Rixy Kids Club
            p
                :typo
                    Концертный зал, зоны отдыха, аквапарки, теннисный корт и даже картинг доступны всем гостям, в то время как для самых маленьких имеются площадки и дневные мероприятия в Rixy Kids Club. Также посетителям предлагают эксклюзивные услуги и бесплатный трансфер до тематического парка The Land of Legends.
    section.three-blocks.held
        .inhalt
            h2 РАЗВЛЕЧЕНИЯ И МЕРОПРИЯТИЯ
            p.text
                :typo
                    Выбор занятий в отеле удовлетворит даже самые строгие вкусы. Профессиональный теннисный корт и самые разнообразные спортивные мероприятия: прогулки на велосипеде, йога, кроссфит, тренировка на батуте и многое другое. Для детей в Rixy Kids Club помимо анимации, конкурсов и мастер классов также предусмотрены спортивные активности.
            p.text
                :typo
                    В спа-центре Anjana Spa можно насладиться процедурами для здоровья и красоты, такими как хамам и массаж, а также насладиться чайной церемонией. В течение дня проводится анимация и вечеринки в бассейне, а вечером на территории Alara Show Center проходит уникальная программа концертов, фестивалей, шоу и вечеринок. Кроме того, все гости получают право на бесплатный трансфер и вход в тематический парк The Land of Legends.
            .blocks_items
                .blocks_item
                    img(src='/site/coral.ru/assets/club-prive-by-rixos-belek/visuals/b-1.webp').hidden-on-mobile
                    img(src='/site/coral.ru/assets/club-prive-by-rixos-belek/visuals/b-1m.webp').hidden-on-desktop
                    .text The Land of Legends

                .blocks_item
                    img(src='/site/coral.ru/assets/club-prive-by-rixos-belek/visuals/b-2.webp').hidden-on-mobile
                    img(src='/site/coral.ru/assets/club-prive-by-rixos-belek/visuals/b-2m.webp').hidden-on-desktop
                    .text Спорт и фитнес
            .pagination
                .dot(data-index='0')
                .dot(data-index='1')
                .dot(data-index='2')


    +coral-bonus()
    +contacts-and-map()
