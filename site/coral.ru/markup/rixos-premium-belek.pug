include ../markup/mixins

- const hotel = hotels.find(hotel => hotel.id === 978);

body
    script
        != `var known_hotel = ${ JSON.stringify(hotel) };`

    +internal-nav([
        { label: 'Номера', ref: 'section.suites' },
        { label: 'Рестораны и бары', ref: 'section.restaurants-and-bars' },
        { label: 'RixyKidsClub', ref: 'section.rixy-club' },
        { label: 'CoralBonus', ref: 'section.coral-bonus' },
        { label: 'Контакты', ref: 'section.leased-line-premium' },
    ], '/chain/rixos/turkey/', '.interactive-map', { label: 'Выбрать номер', ref: 'section.suites' })

    +kvv({
        h1: 'Rixos Premium Belek',
        logo: '/site/coral.ru/assets/logos/rixos-belek.png',
        desktop_poster: '/site/coral.ru/assets/rixos-premium-belek/kv.webp',
        mobile_poster:  '/site/coral.ru/assets/rixos-premium-belek/kv_m.webp',
        desktop_vid: 1103730839,
        mobile_vid: 1103730887,
        video_scale: 1.5,
        five_stars: true,
        location: 'Турция, Белек'
    })

    section.held.intro
        .inhalt
            h2 Добро пожаловать <br>в Rixos Premium Belek
            p.generic
                :typo
                    Отель окружает сосновый лес, благодаря которому сам воздух напитан ароматом хвои, и заниматься спортом здесь – одно удовольствие. Посетителям всех возрастов предлагают на выбор более 20 активностей, которые можно сочетать с купанием, дневной развлекательной программой, а также вечерними выступлениями диджея, артистов и живой музыкой. 
            p.generic
                :typo
                    Для маленьких туристов работает Rixy Kids Club, в котором детей всех возрастов ждут веселые мероприятия и развлечения на весь день. Взрослые смогут принять участие в ежедневных спортивных мероприятиях, таких как пилатес, йога, настольный теннис, бокс на воде и многих других, а после этого расслабиться в сауне или хамаме в Anjana Spa.

            .actions
                button.knopf(data-ref='section.suites') Выбрать номер

    section.held.suites
        .inhalt
            h2.rooms-splitter
            .rooms-list-combo
                .rooms-grid
                .rooms-paging.discrete-pager

    +gallery([
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-belek/gallery/01-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-belek/gallery/01-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-belek/gallery/02-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-belek/gallery/02-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-belek/gallery/03-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-belek/gallery/03-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-belek/gallery/04-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-belek/gallery/04-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-belek/gallery/05-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-belek/gallery/05-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-belek/gallery/06-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-belek/gallery/06-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-belek/gallery/07-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-belek/gallery/07-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-belek/gallery/08-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-belek/gallery/08-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-belek/gallery/09-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-belek/gallery/09-gallery-mobile.webp' },
    ])

    +restaurants-and-bars({
        about: 'Составьте свой мини-гастрономический тур, включающий 6 ресторанов и 8 баров. Разнообразие мест и кухонь даст вам возможность пробовать что-то новое каждый день в уникальной атмосфере.',
        restaurants: [
            {
                visual: '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/rest-04.webp',
                heading: 'Akşam',
                body: 'Ресторан современной турецкой кухни порадует любителей национальных блюд и яркой атмосферой.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/rest-06.webp',
                heading: 'Piazzetta Italiana',
                body: 'Отведайте шедевры и классику итальянской кухни в уютном помещении или за уличными столиками.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/rest-02.webp',
                heading: 'Z’asya',
                body: 'Изысканные блюда паназиатской кухни на любой вкус.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/rest-05.webp',
                heading: 'MYKORINI',
                body: 'Ощутите настроение и вкус греции в блюдах, приготовленных профессионалами.'
            },
            {
                visual:  '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/rest-01.webp',
                heading: 'Turquoise Restaurant',
                body:    'Главный ресторан отеля, в котором завтрак, обед и ужин обслуживаются по системе шведский стол.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/rest-07.webp',
                heading: 'People’s',
                body: 'Ресторан системы а-ля карт, где шеф-повар сможет радовать вас авторскими блюдами 24/7. '
            },
            {
                visual:  '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/rest-03.webp',
                heading: 'Food Court',
                body:    'Здесь вы сможете подкрепиться во время обеда и ужина'
            },
            {
                visual:  '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/rest-12.webp',
                heading: 'Godiva Café',
                body:    'Здесь вы можете попробовать шоколадные конфеты, разнообразные десерты и теплые фирменные круассаны. '
            },
            {
                visual:  '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/rest-13.webp',
                heading: 'Rixy Restaurant',
                body:    'Ресторан для детей и их родителей, где меню составлено с учетом всего необходимого для растущего организма.'
            },
        ],
        bars: [
            {
                visual: '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/bar-02.webp',
                heading: 'Rixos Lounge',
                body: 'Место, покоряющее своей атмосферой эксклюзивности и превосходными напитками.'
            },
            {
                visual:  '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/bar-01.webp',
                heading: 'Lobby Bar',
                body:    'Большой выбор чая и кофе, а также маленьких закусок, порадуют даже самых взыскательных.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/bar-07.webp',
                heading: 'Beach Bar',
                body: 'Наслаждайтесь прохладительными и алкогольными напитками прямо на пляже под живую музыку.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/bar-06.webp',
                heading: 'Irish Sports Bar',
                body: 'Спорт бар, помимо алкогольных напитков предоставляющий горячее и закуски.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/bar-04.webp',
                heading: 'Troy Bar',
                body: 'Огромный выбор напитков и сортов кофе для гостей, отдыхающих в Suites.'
            },
            {
                visual:  '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/bar-03.webp',
                heading: 'Starbucks',
                body:    'Классическое меню известной сети кофеен в отеле и на пляже.'
            },
            {
                visual:  '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/bar-05.webp',
                heading: 'C-Bar | Anjana Spa',
                body:    'Витаминное меню и детокс-напитки прямо в спа-центре.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-belek/restaurants-and-bars/bar-09.webp',
                heading: 'Mood Night Club',
                body: 'Ночной клуб при отеле, где помимо напитков можно насладиться танцами и поучаствовать в вечерней программе.'
            },
        ]
    })

    section.held.edge2edge.rixy-club.visuals-x-slider
        .x-slider
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-belek/rixy-club/01-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-belek/rixy-club/01-mobile.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-belek/rixy-club/02-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-belek/rixy-club/02-mobile.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-belek/rixy-club/03-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-belek/rixy-club/03-mobile.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-belek/rixy-club/04-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-belek/rixy-club/04-mobile.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-belek/rixy-club/05-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-belek/rixy-club/05-mobile.webp)')
        .overlay
            h2 Rixy Kids Club
            p
                :typo
                    Для маленьких туристов работает Rixy Kids Club, в котором детей всех возрастов ждут веселые мероприятия и развлечения на весь день. Взрослые смогут принять участие в ежедневных спортивных мероприятиях, таких как пилатес, йога, настольный теннис, бокс на воде и многих других, а после этого расслабиться в сауне или хамаме в Anjana Spa.
    section.three-blocks.held
        .inhalt
            h2 РАЗВЛЕЧЕНИЯ И МЕРОПРИЯТИЯ
            p.text
                :typo
                    Активных гостей ждут мероприятия спортивного характера, групповые и частные занятия и соревнования, после которых можно отдохнуть и расслабиться в умиротворяющей атмосфере Anjana Spa, где можно посетить баню, поплавать в крытом бассейне и насладиться другими оздоровительными процедурами.
            p.text
                :typo
                    В течение дня в отеле проводится множество мероприятий: живая музыка, арт-мастерская, эксклюзивные вечеринки и прочие, а вечером гостей ждут выступления артистов и дискотеки. Также все гости смогут посетить The Land of Legends, знаменитый парк развлечений с множеством увлекательных тематических зон.
            .blocks_items
                .blocks_item
                    img(src='/site/coral.ru/assets/rixos-premium-belek/visuals/b-1.webp').hidden-on-mobile
                    img(src='/site/coral.ru/assets/rixos-premium-belek/visuals/b-1m.webp').hidden-on-desktop
                    .text спа-центр Anjana
                .blocks_item
                    img(src='/site/coral.ru/assets/rixos-premium-belek/visuals/b-2.webp').hidden-on-mobile
                    img(src='/site/coral.ru/assets/rixos-premium-belek/visuals/b-2m.webp').hidden-on-desktop
                    .text тематические вечеринки
                .blocks_item
                    img(src='/site/coral.ru/assets/rixos-premium-belek/visuals/b-3.webp').hidden-on-mobile
                    img(src='/site/coral.ru/assets/rixos-premium-belek/visuals/b-3m.webp').hidden-on-desktop
                    .text Спорт и фитнес
            .pagination
                .dot(data-index='0')
                .dot(data-index='1')
                .dot(data-index='2')



    +coral-bonus()
    +contacts-and-map()
