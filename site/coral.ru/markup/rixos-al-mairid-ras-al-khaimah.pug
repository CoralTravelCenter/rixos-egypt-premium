include ../markup/mixins

- const hotel = hotels.find(hotel => hotel.id === 2055);

body
    script
        != `var known_hotel = ${ JSON.stringify(hotel) };`

    +internal-nav([
        { label: 'Номера', ref: 'section.suites' },
        { label: 'Рестораны и бары', ref: 'section.restaurants-and-bars' },
        { label: 'CoralBonus', ref: 'section.coral-bonus' },
        { label: 'Контакты', ref: 'section.leased-line-premium' },
    ], '/chain/rixos/uae/', '.interactive-map', { label: 'Выбрать номер', ref: 'section.suites' })

    +kvv({
        h1: 'Rixos Al Mairid Ras Al Khaimah',
        logo: '/site/coral.ru/assets/logos/rixos-al-mairid-ras-al-khaimah.png',
        desktop_poster: '/site/coral.ru/assets/rixos-marina-abu-dhabi/kv-poster-desktop.jpg',
        mobile_poster:  '/site/coral.ru/assets/rixos-marina-abu-dhabi/kv-poster-mobile.jpg',
        desktop_vid: 1110867301,
        mobile_vid: 1110867244,
        video_scale: 1.5,
        five_stars: true,
        location: 'ОАЭ, Рас-эль-Хайма'
    })

    section.held.intro
        .inhalt
            h2 Добро пожаловать в Rixos Al Mairid Ras Al Khaimah
            p.generic
                :typo
                    Изысканный пляжный курорт для всей семьи, расположенный в самом центре Аравийского полуострова. Погрузитесь в атмосферу роскоши и гостеприимства, окруженными захватывающими пейзажами: пустынными дюнами, белоснежными пляжами и величественными горами. Этот отмеченный наградами курорт предлагает незабываемые впечатления в сочетании с современными удобствами. Курорт расположен на фоне завораживающей песчаной бухты с полуторакилометровым частным пляжем и отличается гармоничным сочетанием современного и традиционного арабского дизайна.
            .actions
                button.knopf(data-ref='section.suites') Выбрать номер

    section.held.suites
        .inhalt
            h2.rooms-splitter
            .rooms-list-combo
                .rooms-grid
                .rooms-paging.discrete-pager

    +gallery([
        { visual_desktop: '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/gallery/01-desktop.jpg', visual_mobile: '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/gallery/01-mobile.jpg' },
        { visual_desktop: '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/gallery/02-desktop.jpg', visual_mobile: '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/gallery/02-mobile.jpg' },
        { visual_desktop: '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/gallery/03-desktop.jpg', visual_mobile: '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/gallery/03-mobile.jpg' },
        { visual_desktop: '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/gallery/04-desktop.jpg', visual_mobile: '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/gallery/04-mobile.jpg' },
        { visual_desktop: '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/gallery/05-desktop.jpg', visual_mobile: '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/gallery/05-mobile.jpg' },
        { visual_desktop: '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/gallery/06-desktop.jpg', visual_mobile: '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/gallery/06-mobile.jpg' },
        { visual_desktop: '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/gallery/07-desktop.jpg', visual_mobile: '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/gallery/07-mobile.jpg' },
    ])

    +restaurants-and-bars({
        subline: 'Откройте вкусы блюд со всего мира',
        about: 'Погрузитесь в мир вкуса и гастрономических открытий в 4 ресторанах и 8 барах отеля. Мясные блюда на гриле, традиционная турецкая и домашняя итальянская кухни разнообразят ваше пребывание и сделают каждый день непохожим на другой.',
        restaurants: [
            {
                visual:  '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/restaurants-and-bars/rest-01.jpg',
                heading: 'Orient Restaurant',
                body:    'Ресторан с новой  интерпретацией турецкой кухни'
            },
            {
                visual:  '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/restaurants-and-bars/rest-02.jpg',
                heading: 'L’olivo Ristorante',
                body:    'Новинками итальянской и средиземноморской кухни'
            },
            {
                visual:  '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/restaurants-and-bars/rest-03.jpg',
                heading: 'Ресторан Turquoise',
                body:    'Главный ресторан с аутентичной турецкой и международной кухней по системе шведский стол'
            },
            {
                visual:  '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/restaurants-and-bars/rest-04.jpg',
                heading: 'Стейк-хаус Toro Loco',
                body:    'Испанский мясной ресторан с лучшей говядиной на гриле'
            },
        ],
        bars: [
            {
                visual:  '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/restaurants-and-bars/bar-01.jpg',
                heading: 'Zest Bar',
                body:    'Насладитесь свежими фруктовыми соками и прохладительными напитками'
            },
            {
                visual:  '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/restaurants-and-bars/bar-02.jpg',
                heading: 'Dome Lounge',
                body:    'Широкий выбор напитков, коктейлей и аперитивов. Также здесь подают свежие салаты и легкие блюда'
            },
            {
                visual:  '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/restaurants-and-bars/bar-03.jpg',
                heading: 'Sol Seafood Grill & Bar',
                body:    'Бар на открытом воздухе с полным меню во время ужина'
            },
            {
                visual:  '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/restaurants-and-bars/bar-04.jpg',
                heading: 'Highlights Pool Bar',
                body:    'Бар у бассейна с инновационными напитками'
            },
            {
                visual:  '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/restaurants-and-bars/bar-05.jpg',
                heading: 'La Bodega',
                body:    'Можно побаловать себя послеобеденным винтажным портвейном или коньяком'
            },
            {
                visual:  '/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/restaurants-and-bars/bar-06.jpg',
                heading: 'Arela',
                body:    'Бар, где можно одновременно насладиться напитками и потрясающей панорамой'
            },
        ]
    })

    section.held.edge2edge.rixy-club.visuals-x-slider
        .x-slider
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/rixy-club/01-desktop.jpg); --visual-mobile: url(/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/rixy-club/01-mobile.jpg)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/rixy-club/02-desktop.jpg); --visual-mobile: url(/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/rixy-club/02-mobile.jpg)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/rixy-club/01-desktop.jpg); --visual-mobile: url(/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/rixy-club/01-mobile.jpg)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/rixy-club/02-desktop.jpg); --visual-mobile: url(/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/rixy-club/02-mobile.jpg)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/rixy-club/01-desktop.jpg); --visual-mobile: url(/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/rixy-club/01-mobile.jpg)')
        .overlay
            h2 Rixy Kids Club & Teen Club
            p
                :typo
                    В отеле проводится круглогодичная программа захватывающих развлечений, включая танцевальные и детские шоу, живую музыку, выступления диджеев и многое другое. В Rixy Kids Club каждого ребенка ждет VIP-обслуживание, интересные игры, мастер-классы и увлекательные шоу в безопасной и познавательной среде. А подростки смогут проводить время в Teens Club, где есть зона для игр, общения и развлечений.


    section.three-blocks.held
        .inhalt
            h2 РАЗВЛЕЧЕНИЯ И МЕРОПРИЯТИЯ
            p.text
                :typo
                    Спа-центр Naturelife Spa, вдохновленный традициями Османской империи, предлагает уникальные процедуры, способствующие гармонии души и тела. Погрузитесь в мир чувственных и телесных терапий, направленных на восстановление баланса и глубокое расслабление. Для активных гостей доступны разнообразные групповые занятия: от пляжного волейбола и пилатеса до зумбы, стретчинга и даже аква-саиклинга и антигравити-йоги.
            .blocks_items
                .blocks_item
                    img(src='/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/visuals/01-desktop.jpg').hidden-on-mobile
                    img(src='/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/visuals/01-mobile.jpg').hidden-on-desktop
                    .text Anjana Spa
                .blocks_item
                    img(src='/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/visuals/02-desktop.jpg').hidden-on-mobile
                    img(src='/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/visuals/02-mobile.jpg').hidden-on-desktop
                    .text Тематические вечеринки
                .blocks_item
                    img(src='/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/visuals/03-desktop.jpg').hidden-on-mobile
                    img(src='/site/coral.ru/assets/rixos-al-mairid-ras-al-khaimah/visuals/03-mobile.jpg').hidden-on-desktop
                    .text Спорт и фитнес
            .pagination
                .dot(data-index='0')
                .dot(data-index='1')
                .dot(data-index='2')

    +coral-bonus()

    +contacts-and-map()
