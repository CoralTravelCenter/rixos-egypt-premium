include ../markup/mixins

- const hotel = hotels.find(hotel => hotel.id === 934);

body
    script
        != `var known_hotel = ${ JSON.stringify(hotel) };`

    +internal-nav([
        { label: 'Номера', ref: 'section.suites' },
        { label: 'Рестораны и бары', ref: 'section.restaurants-and-bars' },
        { label: 'RixyKidsClub', ref: 'section.rixy-club' },
        { label: 'CoralBonus', ref: 'section.coral-bonus' },
        { label: 'Контакты', ref: 'section.leased-line-premium' },
    ], '/chain/rixos/turkey/', '.interactive-map', { label: 'Выбрать номер', ref: 'section.suites' })

    +kvv({
        h1: 'Rixos Sungate',
        logo: '/site/coral.ru/assets/logos/rixos-sungate.png',
        desktop_poster: '/site/coral.ru/assets/rixos-premium-sungate/kv.webp',
        mobile_poster:  '/site/coral.ru/assets/rixos-premium-sungate/kv_m.webp',
        desktop_vid: 1103731461,
        mobile_vid: 1103731492,
        video_scale: 1.5,
        five_stars: true,
        location: 'Турция, Кемер'
    })

    section.held.intro
        .inhalt
            h2 Добро пожаловать в Rixos Sungate 5*Deluxe
            p.generic
                :typo
                    Это один из самых популярных отелей сети Rixos. Его огромная озелененная территория имеет все необходимое для роскошного отдыха. Здесь можно почувствовать себя по-настоящему VIP-персоной, насладиться услугами спа-центров, принять участие в групповых или частных занятиях спортом и побывать на живых представлениях под открытым небом.
            p.generic
                :typo
                    Концертный зал, зоны отдыха, аквапарки, теннисный корт доступны всем гостям, в то время как для самых маленьких имеются площадки и дневные мероприятия в Rixy Kids Club. Также посетителям предлагают эксклюзивные услуги и бесплатный трансфер до тематического парка The Land of Legends.

            .actions
                button.knopf(data-ref='section.suites') Выбрать номер

    section.held.suites
        .inhalt
            h2.rooms-splitter
            .rooms-list-combo
                .rooms-grid
                .rooms-paging.discrete-pager

    +gallery([
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-sungate/gallery/01-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-sungate/gallery/01-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-sungate/gallery/02-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-sungate/gallery/02-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-sungate/gallery/03-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-sungate/gallery/03-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-sungate/gallery/04-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-sungate/gallery/04-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-sungate/gallery/05-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-sungate/gallery/05-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-sungate/gallery/06-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-sungate/gallery/06-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-sungate/gallery/07-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-sungate/gallery/07-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-sungate/gallery/08-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-sungate/gallery/08-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-sungate/gallery/09-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-sungate/gallery/09-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-sungate/gallery/10-gallery-desktop.jpg', visual_mobile: '/site/coral.ru/assets/rixos-premium-sungate/gallery/10-gallery-mobile.jpg' },
    ])

    +restaurants-and-bars({
        about: 'Атмосфера и профессионализм поваров дадут вам в полной мере насладиться как необычными, так и классическими блюдами турецкой, мексиканской, японской и других кухонь мира. Здесь также есть заведения, где подают свежие морепродукты и десерты.',
        subline: 'Путешествие по кухням мира',
        restaurants: [
            {
                visual: '/site/coral.ru/assets/rixos-premium-sungate/restaurants-and-bars/rest-01.webp',
                heading: 'Turquoise',
