include ../markup/mixins

- const known_hotels = hotels.filter(hotel => !!hotel.id).filter(hotel => hotel.country === 'ОАЭ');

body
    +internal-nav([
        {label: 'Отели', ref: 'section.rixos-hotels'},
        {label: 'CoralBonus', ref: 'section.coral-bonus'},
        {label: 'Контакты', ref: 'section.leased-line-premium'},
    ], '/chain/rixos/', '.interactive-map', {label: 'Выбрать отель', ref: 'section.rixos-hotels'})

    +kvv({
        h1: 'All Inclusive – All Exclusive',
        desktop_poster: '/site/coral.ru/assets/kv-poster-desktop-new.webp',
        mobile_poster: '/site/coral.ru/assets/kv-poster-mobile-new.webp',
        desktop_vid: 1107679517,
        mobile_vid: 1107680259
    })

    section.held.intro.unique-concept
        .inhalt
            p.generic
                :typo
                    «All inclusive — All exclusive» – главная философия премиальной сети Rixos Hotels. Она объединяет все преимущества системы «Все включено» и уникальные привилегии, доступные только для гостей отелей. Каждый резорт предлагает исключительные возможности, которые превосходят все ожидания. Rixos Hotels — это отели, где мечты об идеальном отдыхе становятся реальностью!
            .actions
                button.knopf(data-ref='section.rixos-hotels') Забронировать

    section.held.edge2edge.rixy-club.visuals-x-slider
        .x-slider
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-magawish/visuals/eg-1.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-magawish/visuals/eg-1m.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-magawish/visuals/eg-2.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-magawish/visuals/eg-2m.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-magawish/visuals/eg-3.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-magawish/visuals/eg-3m.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-magawish/visuals/eg-4.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-magawish/visuals/eg-4m.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-magawish/visuals/eg-5.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-magawish/visuals/eg-5m.webp)')

    section.held.entertainment-section
        +entertainment({
            heading: 'Преимущества отдыха в Rixos',
            ps: [
                'Окунитесь в мир благополучия вместе с нашей командой профессиональных фитнес-тренеров Exclusive Sports Club, которые готовы провести вас через бодрящие спортивные тренировки. Независимо от того, являетесь ли вы энтузиастом фитнеса или только начинаете свой путь к оздоровлению, наши тренеры позаботятся о том, чтобы каждое занятие соответствовало вашим индивидуальным потребностям.',
                'Погрузитесь в мир релаксации и омоложения в нашем изысканном спа-центре Anjana, где спокойствие сочетается с наслаждением. Наши опытные специалисты создают индивидуальные спа-процедуры, предлагая симфонию спокойствия для вашего разума, тела и души.'
            ],
            lefty: {
                title: 'Rixy Kids Club',
                text: 'Идеальный отдых — это счастливая семья! Расслабьтесь и отдохните, пока ваши любимые малыши и подростки веселятся, открывают таланты и заводят новых друзей под присмотром внимательных аниматоров. Танцевальная академия, творческие мастер-классы, программы, которые направлены на развитие логики, и многое другое придётся по душе юным гостям. Rixy Kids Club принимает детей от 4 до 17 лет.',
                visual_desktop: '/site/coral.ru/assets/le-1.webp',
                visual_mobile: '/site/coral.ru/assets/l-1m.webp'
            },
            righty: {
                title: 'Спа и восстановление',
                text: 'Насладитесь полным спектром оздоровительных услуг в спа-центер Anjana: сауны, паровые бани, бассейны, джакузи, снежные и соляные комнаты. Также вы можете побаловать себя антивозрастными и обновляющимися процедурами для лица с использованием косметики известных брендов и фирменных продуктов Rixos.',
                visual_desktop: '/site/coral.ru/assets/ri-1.webp',
                visual_mobile: '/site/coral.ru/assets/ri-1m.webp'
            }

        })


