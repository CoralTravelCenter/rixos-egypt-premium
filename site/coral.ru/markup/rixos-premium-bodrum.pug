include ../markup/mixins

- const hotel = hotels.find(hotel => hotel.id === 805);

body
    script
        != `var known_hotel = ${ JSON.stringify(hotel) };`

    +internal-nav([
        { label: 'Номера', ref: 'section.suites' },
        { label: 'Рестораны и бары', ref: 'section.restaurants-and-bars' },
        { label: 'RixyKidsClub', ref: 'section.rixy-club' },
        { label: 'CoralBonus', ref: 'section.coral-bonus' },
        { label: 'Контакты', ref: 'section.leased-line-premium' },
    ], '/chain/rixos/turkey/', '.interactive-map', { label: 'Выбрать номер', ref: 'section.suites' })

    +kvv({
        h1: 'Rixos Premium bodrum',
        logo: '/site/coral.ru/assets/logos/rixos-premium-bodrum.png',
        desktop_poster: '/site/coral.ru/assets/rixos-premium-bodrum/kv.webp',
        mobile_poster:  '/site/coral.ru/assets/rixos-premium-bodrum/kv_m.webp',
        desktop_vid: 1103731273,
        mobile_vid: 1103731305,
        video_scale: 1.5,
        five_stars: true,
        location: 'Турция, Бодрум'
    })

    section.held.intro
        .inhalt
            h2 Добро пожаловать в Rixos Premium Bodrum 5*Deluxe
            p.generic
                :typo
                    Оживленная ночная жизнь Бодрума, спортивные и развлекательные активности в самом отеле придутся по душе тем, кто хочет установить свой темп отдыха и насладиться всеми возможностями.
            p.generic
                :typo
                    Спортивные фестивали, спа-центры для восстановления баланса сил, концерты и живая музыка наполнят каждый ваш день новыми открытиями, а рестораны с разнообразной кухней разных стран мира дадут возможность отправиться в кругосветное гастрономическое турне прямо в отеле.
            .actions
                button.knopf(data-ref='section.suites') Выбрать номер

    section.held.suites
        .inhalt
            h2.rooms-splitter
            .rooms-list-combo
                .rooms-grid
                .rooms-paging.discrete-pager

    +gallery([
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/01-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/01-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/02-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/02-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/03-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/03-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/04-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/04-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/05-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/05-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/06-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/06-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/07-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/07-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/08-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/08-gallery-mobile.webp' },
        { visual_desktop: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/09-gallery-desktop.webp', visual_mobile: '/site/coral.ru/assets/rixos-premium-bodrum/gallery/09-gallery-mobile.webp' },
    ])

    +restaurants-and-bars({
        subline: 'Кухни разных стран мира',
        about: 'Отдых с гастрономическим уклоном разнообразят 6 ресторанов, каждый из которых имеет уникальную атмосферу и готов порадовать гостей блюдами разных стран, приготовленных профессиональными поварами.',
        restaurants: [
            {
                visual:  '/site/coral.ru/assets/rixos-premium-bodrum/restaurants-and-bars/rest-01.webp',
                heading: 'Turquoise',
                body:    'Основной ресторан, работающий по системе шведский стол.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-bodrum/restaurants-and-bars/rest-02.webp',
                heading: 'People’s',
                body: 'Ресторан международной кухни, в котором можно поесть прямо на берегу моря.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-bodrum/restaurants-and-bars/rest-03.webp',
                heading: 'L’olivo',
                body: 'Попробуйте Италию на вкус в приятной домашней атмосфере.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-bodrum/restaurants-and-bars/rest-04.webp',
                heading: 'Kalamata',
                body: 'Ресторан, где вас удивят лучшими блюдами греческой кухни.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-bodrum/restaurants-and-bars/rest-05.webp',
                heading: 'Umi Teppanyaki',
                body: 'Разбавьте свой отпуск яркими вкусами паназии.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-bodrum/restaurants-and-bars/rest-06.webp',
                heading: 'Patisserie Art',
                body: 'Кондитерская, где вы можете порадовать себя свежими десертами.'
            },
        ],
        bars: [
            {
                visual:  '/site/coral.ru/assets/rixos-premium-bodrum/restaurants-and-bars/bar-01.webp',
                heading: 'Oliver Lobby Бар',
                body:    'Большой ассортимент безалкогольных и алкогольных напитков, а также чая и кофе круглые сутки.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-bodrum/restaurants-and-bars/bar-02.webp',
                heading: 'Pool Бар',
                body: 'Отдыхайте в комфорте и наслаждайтесь прохладительными напитками у бассейна.'
            },
            {
                visual: '/site/coral.ru/assets/rixos-premium-bodrum/restaurants-and-bars/bar-03.webp',
                heading: 'Neria Beach Бар',
                body: 'Бар, расположенный на пирсе, подает напитки на любой вкус.'
            },

        ]
    })

    section.held.edge2edge.rixy-club.visuals-x-slider
        .x-slider
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-bodrum/rixy-club/01-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-bodrum/rixy-club/01-mobile.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-bodrum/rixy-club/02-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-bodrum/rixy-club/02-mobile.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-bodrum/rixy-club/03-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-bodrum/rixy-club/03-mobile.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-bodrum/rixy-club/04-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-bodrum/rixy-club/04-mobile.webp)')
            .x-slide(style='--visual-desktop: url(/site/coral.ru/assets/rixos-premium-bodrum/rixy-club/05-desktop.webp); --visual-mobile: url(/site/coral.ru/assets/rixos-premium-bodrum/rixy-club/05-mobile.webp)')
        .overlay
            h2 Rixy Kids Club
            p
                :typo
                    Дети смогут провести целый день в Rixy Kids Club, где аниматоры не дадут заскучать ни на минуту. Для всех гостей отеля работает спа-центр, в котором можно посетить сауну и хамам, отдохнуть в специальной зоне отдыха и расслабиться после дневной нагрузки.
    section.three-blocks.held
        .inhalt
            h2 РАЗВЛЕЧЕНИЯ И МЕРОПРИЯТИЯ
            p.text
                :typo
                    Отличное место для отдыха с друзьями и семьей, где каждый найдет развлечение на свой вкус. Любителей активного отдыха порадует широкий выбор развлекательных программ, мероприятий и тематических вечеринок. Для активных туристов работает фитнес-центр, где опытные тренеры проводят как общие, так и частные уроки. Вы сможете заняться пилатесом, кроссфитом, йогой, аква фитнесом и другими видами спорта.
            .blocks_items
                .blocks_item
                    img(src='/site/coral.ru/assets/rixos-premium-bodrum/visuals/b-1.webp').hidden-on-mobile
                    img(src='/site/coral.ru/assets/rixos-premium-bodrum/visuals/b-1m.webp').hidden-on-desktop
                    .text спа-центр Anjana
                .blocks_item
                    img(src='/site/coral.ru/assets/rixos-premium-bodrum/visuals/b-2.webp').hidden-on-mobile
                    img(src='/site/coral.ru/assets/rixos-premium-bodrum/visuals/b-2m.webp').hidden-on-desktop
                    .text тематические вечеринки
                .blocks_item
                    img(src='/site/coral.ru/assets/rixos-premium-bodrum/visuals/b-3.webp').hidden-on-mobile
                    img(src='/site/coral.ru/assets/rixos-premium-bodrum/visuals/b-3m.webp').hidden-on-desktop
                    .text Спорт и фитнес
            .pagination
                .dot(data-index='0')
                .dot(data-index='1')
                .dot(data-index='2')
    +coral-bonus()
    +contacts-and-map()
